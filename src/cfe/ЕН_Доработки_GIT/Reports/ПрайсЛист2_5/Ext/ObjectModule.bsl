
&ИзменениеИКонтроль("ПередЗагрузкойВариантаНаСервере")
Процедура ЕНДор_ПередЗагрузкойВариантаНаСервере(Форма, НовыеНастройкиКД)

	Отчет = Форма.Отчет; 
	
	#Вставка
	Форма.УстановитьРежимОтображенияРезультата(РежимОтображенияРезультатаОтчета.Компактный);	
	#КонецВставки

	КомпоновщикНастроекФормы = Отчет.КомпоновщикНастроек;

	// Изменение настроек по функциональным опциям
	НастроитьПараметрыОтборыПоФункциональнымОпциям(КомпоновщикНастроекФормы);

	НовыеНастройкиКД = КомпоновщикНастроекФормы.Настройки;

КонецПроцедуры
