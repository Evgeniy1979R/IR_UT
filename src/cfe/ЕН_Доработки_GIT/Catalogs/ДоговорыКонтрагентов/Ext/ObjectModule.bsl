
&После("ПередЗаписью")
Процедура ЕНДор_ПередЗаписью(Отказ)
	Если СтрНайти(Комментарий,"{IR") = 0 Тогда 
		Запрос = Новый Запрос;
		  Запрос.Текст = "ВЫБРАТЬ
		  |	МАКСИМУМ(ВЫБОР
		  |			КОГДА СТРНАЙТИ(ДоговорыКонтрагентов.Комментарий, ""{IR"") > 0
		  |				ТОГДА ПОДСТРОКА(ДоговорыКонтрагентов.Комментарий, СТРНАЙТИ(ДоговорыКонтрагентов.Комментарий, ""{IR"") + 3, 9)
		  |			ИНАЧЕ """"
		  |		КОНЕЦ) КАК МаксНомер
		  |ИЗ
		  |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		  |";
		  тМаксНомер = Запрос.Выполнить().Выгрузить();
		  Номер = ПреобразоватьВЧисло(тМаксНомер[0].МаксНомер)+1;
		  ТекстНомер = Прав("000000000"+Формат(Номер,"ЧГ="),9);
		  Комментарий = СтрШаблон("%1%2%3%4",Комментарий,"{IR",ТекстНомер,"}");


	КонецЕсли;
КонецПроцедуры

  Функция   ПреобразоватьВЧисло(ЧислоСтрока)
	  ЧислоСтрока = СтрЗаменить(ЧислоСтрока,",",".");
	  ДопустимыеСимволыЧисла = "0123456789";
	  СтрокаРезультат ="";
	  Для НСимвола = 1 По СтрДлина(ЧислоСтрока) Цикл
		  Если СтрНайти(ДопустимыеСимволыЧисла,Сред(ЧислоСтрока,НСимвола,1))> 0 Тогда
			  СтрокаРезультат = СтрокаРезультат + Сред(ЧислоСтрока,НСимвола,1);
		  КонецЕсли;
	  КонецЦикла;
	  Возврат ?(СтрокаРезультат = "",0,Число(СтрокаРезультат));
  КонецФункции //ПреобразоватьВЧисло
