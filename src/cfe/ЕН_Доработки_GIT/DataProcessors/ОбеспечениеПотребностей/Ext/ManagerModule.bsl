
&ИзменениеИКонтроль("КоличествоКЗаказуДляПоддержанияЗапаса")
Функция ЕНДор_КоличествоКЗаказуДляПоддержанияЗапаса(Товар)
	
	#Вставка
	Если Товар = Неопределено Тогда 
		Возврат -3.14;
	КонецЕсли;
	#КонецВставки

	ДоТочкиЗаказа = Товар.Остаток - Товар.МинимальныйЗапас;

	ВосполнениеСтраховогоЗапаса = Мин(Товар.СтраховойЗапас, Макс(0, -ДоТочкиЗаказа));
	КЗаказу =
	Макс(0,
	Товар.МаксимальныйЗапас
	- Товар.СтраховойЗапас
	- Товар.ЗаказыКпоступлению
	- Товар.НаКонтролеКачества
	- Макс(0, ДоТочкиЗаказа)
	+ ВосполнениеСтраховогоЗапаса)
	+ Макс(0,
	Мин(Товар.РезервыНаСкладе, -Товар.Остаток));

	ДатаЗаказаНаступила = Товар.КЗаказуТовары = 1;
	ТочкаЗаказаНаступила = ДоТочкиЗаказа <= 0;
	Отметка = Товар.КЗаказуТовары <> 2 И (ДатаЗаказаНаступила Или ТочкаЗаказаНаступила) И КЗаказу > 0;
	
	#Вставка
	Если Товар.МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс") Тогда 
		КЗаказу = Макс(0,КЗаказу-Товар.Остаток);
	КонецЕсли;
	#КонецВставки
	
	Результат = Новый Структура();
	Результат.Вставить("КЗаказу",              КЗаказу);
	Результат.Вставить("Отметка",              Отметка);
	Результат.Вставить("ДатаЗаказаНаступила",  ДатаЗаказаНаступила);
	Результат.Вставить("ТочкаЗаказаНаступила", ТочкаЗаказаНаступила);
	Результат.Вставить("ДоТочкиЗаказа",        ДоТочкиЗаказа);

	Возврат Результат;

КонецФункции
 


